# LYNX is a Linux dotfiles repo that may be edited or cloned on other platforms.
# Everything must land on disk with LF endings: a CRLF inside a shell script or
# a Hyprland config is a silent runtime failure that is genuinely painful to
# diagnose ("bad interpreter", or a config line that just quietly does nothing).
* text=auto eol=lf

*.sh    text eol=lf
*.lua   text eol=lf
*.conf  text eol=lf
*.jsonc text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.rasi  text eol=lf
*.toml  text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

# bin/lx has no extension; pin it explicitly.
bin/lx  text eol=lf

# Never touch binary assets.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ttf  binary
*.otf  binary
